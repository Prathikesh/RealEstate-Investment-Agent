# ── Database ───────────────────────────────────────────────────────────────────
# Standard postgres:// URL — the app automatically appends +asyncpg for async
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/quebec_realestate

# ── Scrapfly ───────────────────────────────────────────────────────────────────
SCRAPFLY_API_KEY=scp-live-xxxxxxxxxxxxxxxxxxxx

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# ── App ────────────────────────────────────────────────────────────────────────
APP_SECRET_KEY=change-me-to-a-long-random-string-in-production
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Admin bootstrap (creates one admin account on first startup) ─────────────
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=change-me

# ── Email (Gmail SMTP or any provider) ────────────────────────────────────────
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@yourdomain.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ── Scraping Schedule ──────────────────────────────────────────────────────────
SCRAPE_INTERVAL_HOURS=6

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
