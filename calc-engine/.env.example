# ScrapFly API key — get yours at https://scrapfly.io
SCRAPFLY_API_KEY=scp-live-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook URL in your existing full-stack app to receive rate-change notifications
# Leave empty to disable webhook (changes will be logged only)
WEBHOOK_URL=https://your-existing-app.com/api/webhooks/rate-change

# SQLite database file path
DB_PATH=./data/rates.db

# Structured JSON audit log path
LOG_PATH=./logs/audit.jsonl

# How often (in weeks) to re-scrape sources for rate changes
RATE_CHECK_INTERVAL_WEEKS=3

# Environment: development | production
ENVIRONMENT=development
